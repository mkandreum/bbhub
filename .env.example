# Obligatoria: contraseña para entrar desde la BlackBerry
APP_PASSWORD=cambia-esto

# Telegram (tu cuenta): crea una app en https://my.telegram.org > API development tools
TG_API_ID=
TG_API_HASH=

# Correo (Gmail: usa una contraseña de aplicación, no la normal)
MAIL_USER=
MAIL_PASSWORD=
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_FROM_NAME=

# Gemini: asistente, traductor, resúmenes y transcripción de notas de voz
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ciudad por defecto del tiempo y fuentes de noticias "Nombre|url,Nombre|url"
WEATHER_CITY=Madrid
NEWS_FEEDS=
